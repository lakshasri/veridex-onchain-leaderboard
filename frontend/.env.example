# Comma-separated chain IDs allowed for the RPC URL and MetaMask (must match for transactions).
# Do not add mainnet (1) for local Ganache/Hardhat work—reads use VITE_RPC_URL while MetaMask sends txs;
# a mismatch makes the UI look fine but Add/Submit hit the wrong chain.
# 31337 = Hardhat node, 1337 = Ganache / many local nodes, 5777 = older Ganache.
VITE_CHAIN_IDS=1337,31337,5777
